<?xml version="1.0"?>

<robot name="two_link_arm">

    <!-- Base Link -->
    <link name="base_link">
        <visual>
            <geometry>
                <box size="0.2 0.2 0.1"/>
            </geometry>

            <material name="gray">
                <color rgba="0.6 0.6 0.6 1"/>
            </material>
        </visual>
    </link>

    <!-- Link 1 -->
    <link name="link1">
        <visual>
            <origin xyz="0.5 0 0" rpy="0 0 0"/>
            <geometry>
                <box size="1 0.1 0.1"/>
            </geometry>

            <material name="blue">
                <color rgba="0.2 0.2 1 1"/>
            </material>
        </visual>
    </link>

    <!-- Joint 1 -->
    <joint name="joint1" type="revolute">
        <parent link="base_link"/>
        <child link="link1"/>
        <origin xyz="0 0 0.05" rpy="0 0 0"/>
        <axis xyz="0 0 1"/>
        <limit lower="-3.14"
               upper="3.14"
               effort="1"
               velocity="1"/>
    </joint>

    <!-- Link 2 -->
    <link name="link2">
        <visual>
            <origin xyz="0.5 0 0" rpy="0 0 0"/>
            <geometry>
                <box size="1 0.1 0.1"/>
            </geometry>

            <material name="green">
                <color rgba="0 1 0 1"/>
            </material>
        </visual>
    </link>

    <!-- Joint 2 -->
    <joint name="joint2" type="revolute">
        <parent link="link1"/>
        <child link="link2"/>
        <origin xyz="1 0 0" rpy="0 0 0"/>
        <axis xyz="0 0 1"/>
        <limit lower="-3.14"
               upper="3.14"
               effort="1"
               velocity="1"/>
    </joint>

</robot>