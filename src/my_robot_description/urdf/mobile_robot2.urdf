
<?xml version="1.0"?>
<robot name="tortoisebot">

  <!-- ================================================= -->
  <!-- BASE LINK -->
  <!-- ================================================= -->

  <link name="base_link">

    <!-- Visual -->
    <visual>
      <origin xyz="0 0 0.05" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.15" length="0.1"/>
      </geometry>
      <material name="blue">
        <color rgba="0.2 0.4 0.8 1"/>
      </material>
    </visual>

    <!-- Collision -->
    <collision>
      <origin xyz="0 0 0.05" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.15" length="0.1"/>
      </geometry>
    </collision>

    <!-- Inertial -->
    <inertial>
      <origin xyz="0 0 0.05" rpy="0 0 0"/>
      <mass value="2.0"/>
      <inertia
        ixx="0.02"
        iyy="0.02"
        izz="0.04"
        ixy="0.0"
        ixz="0.0"
        iyz="0.0"/>
    </inertial>

  </link>


  <!-- ================================================= -->
  <!-- LEFT WHEEL -->
  <!-- ================================================= -->

  <link name="left_wheel">

    <!-- Visual -->
    <visual>
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      <geometry>
        <cylinder radius="0.05" length="0.02"/>
      </geometry>
      <material name="black">
        <color rgba="0 0 0 1"/>
      </material>
    </visual>

    <!-- Collision -->
    <collision>
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      <geometry>
        <cylinder radius="0.05" length="0.02"/>
      </geometry>
    </collision>

    <!-- Inertial -->
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.2"/>
      <inertia
        ixx="0.00027"
        iyy="0.00027"
        izz="0.00025"
        ixy="0.0"
        ixz="0.0"
        iyz="0.0"/>
    </inertial>

  </link>

  <joint name="left_wheel_joint" type="continuous">
    <parent link="base_link"/>
    <child link="left_wheel"/>
    <origin xyz="0 0.16 0.02" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
  </joint>


  <!-- ================================================= -->
  <!-- RIGHT WHEEL -->
  <!-- ================================================= -->

  <link name="right_wheel">

    <!-- Visual -->
    <visual>
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      <geometry>
        <cylinder radius="0.05" length="0.02"/>
      </geometry>
      <material name="black">
        <color rgba="0 0 0 1"/>
      </material>
    </visual>

    <!-- Collision -->
    <collision>
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      <geometry>
        <cylinder radius="0.05" length="0.02"/>
      </geometry>
    </collision>

    <!-- Inertial -->
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.2"/>
      <inertia
        ixx="0.00027"
        iyy="0.00027"
        izz="0.00025"
        ixy="0.0"
        ixz="0.0"
        iyz="0.0"/>
    </inertial>

  </link>

  <joint name="right_wheel_joint" type="continuous">
    <parent link="base_link"/>
    <child link="right_wheel"/>
    <origin xyz="0 -0.16 0.02" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
  </joint>


  <!-- ================================================= -->
  <!-- CASTER WHEEL (REAR) -->
  <!-- ================================================= -->

  <link name="caster_wheel">

    <!-- Visual -->
    <visual>
      <origin xyz="-0.1 0 -0.01" rpy="0 0 0"/>
      <geometry>
        <sphere radius="0.02"/>
      </geometry>
      <material name="gray">
        <color rgba="0.5 0.5 0.5 1"/>
      </material>
    </visual>

    <!-- Collision -->
    <collision>
      <origin xyz="-0.1 0 -0.01" rpy="0 0 0"/>
      <geometry>
        <sphere radius="0.02"/>
      </geometry>
    </collision>

    <!-- Inertial -->
    <inertial>
      <origin xyz="-0.1 0 -0.01" rpy="0 0 0"/>
      <mass value="0.05"/>
      <inertia
        ixx="0.000008"
        iyy="0.000008"
        izz="0.000008"
        ixy="0.0"
        ixz="0.0"
        iyz="0.0"/>
    </inertial>

  </link>

  <joint name="caster_wheel_joint" type="fixed">
    <parent link="base_link"/>
    <child link="caster_wheel"/>
    <origin xyz="0 0 0.001" rpy="0 0 0"/>
  </joint>


  <!-- ================================================= -->
  <!-- FRONT CASTER WHEEL -->
  <!-- ================================================= -->

  <link name="front_caster_wheel">

    <!-- Visual -->
    <visual>
      <origin xyz="0.1 0 -0.01" rpy="0 0 0"/>
      <geometry>
        <sphere radius="0.02"/>
      </geometry>
      <material name="gray">
        <color rgba="0.5 0.5 0.5 1"/>
      </material>
    </visual>

    <!-- Collision -->
    <collision>
      <origin xyz="0.1 0 -0.01" rpy="0 0 0"/>
      <geometry>
        <sphere radius="0.02"/>
      </geometry>
    </collision>

    <!-- Inertial -->
    <inertial>
      <origin xyz="0.1 0 -0.01" rpy="0 0 0"/>
      <mass value="0.05"/>
      <inertia
        ixx="0.000008"
        iyy="0.000008"
        izz="0.000008"
        ixy="0.0"
        ixz="0.0"
        iyz="0.0"/>
    </inertial>

  </link>

  <joint name="front_caster_wheel_joint" type="fixed">
    <parent link="base_link"/>
    <child link="front_caster_wheel"/>
    <origin xyz="0 0 0.001" rpy="0 0 0"/>
  </joint>


  <!-- ================================================= -->
  <!-- GAZEBO FORTRESS DIFFERENTIAL DRIVE PLUGIN -->
  <!-- ================================================= -->

  <gazebo>
    <plugin
      filename="libignition-gazebo-diff-drive-system.so"
      name="ignition::gazebo::systems::DiffDrive">

      <!-- Existing wheel joints -->
      <left_joint>left_wheel_joint</left_joint>
      <right_joint>right_wheel_joint</right_joint>

      <!-- Robot dimensions -->
      <wheel_separation>0.32</wheel_separation>
      <wheel_radius>0.05</wheel_radius>

      <!-- Velocity command topic -->
      <topic>/cmd_vel</topic>

      <!-- Odometry -->
      <odom_topic>/odom</odom_topic>
      <frame_id>odom</frame_id>
      <child_frame_id>base_link</child_frame_id>
      <odom_publish_frequency>30</odom_publish_frequency>

    </plugin>
  </gazebo>

</robot>
